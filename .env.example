# ============================================================
# Soul 聊天助手 — 环境变量配置（复制为 .env 后填入真实 Key）
#   cp .env.example .env        # Linux / macOS
#   copy .env.example .env      # Windows CMD
#   Copy-Item .env.example .env # Windows PowerShell
# 修改后需重启 npm run dev
# ============================================================

# ── 爱易威 API（主线路，必填其一）────────────────────────────
# 从爱易威控制台复制，通常以 sk- 开头
# 配置后前端「设置」里可不填 Key，由服务端代发请求
AIYIWEI_API_KEY=sk-your-aiyiwei-api-key-here

# 爱易威路由后缀（可选）：floor | nitro | stable | none
# 默认 stable（成功率较高）；若某后缀持续饱和可改为 nitro 或 floor
# AIYIWEI_CHAT_ROUTING_SUFFIX=stable
# AIYIWEI_ANALYSIS_ROUTING_SUFFIX=stable

# ── OpenRouter（爱易威饱和时的备用线路，强烈建议配置）────────
# 申请地址：https://openrouter.ai/keys
# Key 必须以 sk-or- 开头（Groq 备用 gsk_ 也可，但 OpenRouter 推荐 sk-or-）
# 爱易威全部分组 busy 时，服务端会自动切到 OpenRouter 免费/低价模型
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── 聚合 API（OpenAI 兼容，可选）────────────────────────────
# 申请：https://juheapi.com · 话术默认 gpt-5.4-mini
# 前端设置选「聚合 API」或在设置里填 Key；也可只配服务端 JUHE_API_KEY
JUHE_API_KEY=your-juhe-api-key-here

# ── 服务端口（本地开发一般不用改）────────────────────────────
PORT=3001
HOST=0.0.0.0

# ── 生产部署 / CORS（本地开发可忽略）─────────────────────────
# SITE_URL=https://your-domain.com
# ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173
# API_ACCESS_TOKEN=your-internal-token
# 前端构建需带上同值，浏览器才会自动附带 x-api-access-token：
# VITE_API_ACCESS_TOKEN=your-internal-token

# ── 生产限流（推荐：Upstash Redis，跨 Vercel 实例共享）────────
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx

# ── 服务端 Prompt 护栏（可选，覆盖默认强制规则）──────────────
# SERVER_SYSTEM_GUARD=【服务端强制】只输出可发送的中文私聊原话……

# ── 高级：超时（毫秒，一般不用改）────────────────────────────
# OPENROUTER_REQUEST_TIMEOUT_MS=120000
# OPENROUTER_FAILOVER_TOTAL_TIMEOUT_MS=180000
